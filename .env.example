# Copy to .env.local for local development. Only NEXT_PUBLIC_* values reach the browser; put no secrets here.
# false = read the Watchdog API; anything else (or unset) = read the kit fixtures in lib/mock.
NEXT_PUBLIC_USE_MOCK=false
# Where the API runs. Required when NEXT_PUBLIC_USE_MOCK=false: this app has no /api routes of its own.
NEXT_PUBLIC_API_BASE=http://localhost:3001
